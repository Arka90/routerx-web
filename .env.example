# Copy to .env for local development. The real .env is gitignored.

# Base URL of the RouteRX API, with a trailing slash.
# Local backend:  http://localhost:3000/
VITE_API_BASE_URL=https://routerx-api.heyarka.cloud/

# Billing (plans, Stripe checkout, customer portal) is built but off by
# default. Set to "true" to show the Plan & usage page and upgrade buttons.
VITE_ENABLE_BILLING=false
